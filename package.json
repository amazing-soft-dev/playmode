{
  "name": "playermode",
  "version": "0.1.0",
  "private": true,
  "description": "PlayerMode: describe a game, play it a minute later.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "check:images": "node scripts/check-images.mjs",
    "images": "node scripts/build-images.mjs",
    "media:fetch": "node scripts/fetch-media.mjs",
    "verify:export": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
