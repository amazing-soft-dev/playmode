# Copy to .env.local for local development. Every value is optional locally.

# Absolute site origin for canonical URLs, the sitemap, robots.txt and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source for repositories. Only "mock" exists today; "supabase" arrives with the backend milestone.
NEXT_PUBLIC_DATA_SOURCE=mock

# Resend: without a key, form emails are logged to the server console instead of sent.
RESEND_API_KEY=
CONTACT_TO=team@playermode.test
CONTACT_FROM="PlayerMode <noreply@playermode.test>"

# Set by Vercel. Analytics and Speed Insights load only when this is "production".
# NEXT_PUBLIC_VERCEL_ENV=production
