{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlayerMode media manifest",
  "description": "Every photo and video on the site, with its free-stock source, author and license.",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "file",
          "source",
          "sourceUrl",
          "downloadUrl",
          "author",
          "license",
          "alt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable id used in code, e.g. media(\"hero-arcade\")"
          },
          "kind": {
            "enum": [
              "photo",
              "video",
              "poster"
            ],
            "description": "poster = still frame of a video, generated locally"
          },
          "file": {
            "type": "string",
            "pattern": "^public/media/",
            "description": "Path of the committed, optimized file"
          },
          "source": {
            "enum": [
              "unsplash",
              "pexels",
              "local"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public page of the original"
          },
          "downloadUrl": {
            "type": "string",
            "description": "Direct download used by fetch-media (empty for local posters)"
          },
          "author": {
            "type": "string"
          },
          "authorUrl": {
            "type": "string"
          },
          "license": {
            "enum": [
              "Unsplash License",
              "Pexels License"
            ]
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "type": "string",
            "description": "Alt text; empty only for decorative video"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "posterOf": {
            "type": "string",
            "description": "For posters: id of the video it belongs to"
          },
          "focal": {
            "type": "string",
            "description": "CSS object-position hint, e.g. '50% 30%'"
          },
          "notes": {
            "type": "string"
          },
          "trimSeconds": {
            "type": "number",
            "description": "Videos: keep only the first N seconds (default 12)"
          },
          "maxWidth": {
            "type": "integer",
            "description": "Videos: encode at most this many pixels wide (default 1920)"
          }
        }
      }
    }
  }
}
